{
  "scope": "Live rule/template API, UI static HTML and JSON Server CRUD with fictional examples; no LLM inference or browser rendering validation",
  "requirements": "requirements.txt",
  "commands": [
    {
      "argv": [
        "npm",
        "ci",
        "--ignore-scripts",
        "--no-audit",
        "--no-fund"
      ]
    }
  ],
  "servers": [
    {
      "argv": [
        "{python}",
        "backend.py"
      ],
      "env": {
        "APP_HOST": "127.0.0.1",
        "APP_PORT": "{port}"
      },
      "ready": "/api/health",
      "checks": [
        {
          "path": "/api/health",
          "json_contains": {
            "status": "ok"
          }
        },
        {
          "path": "/api/analyze",
          "method": "POST",
          "body": {
            "text": "蒙古包里的聚会"
          },
          "json_contains": {
            "success": true
          }
        },
        {
          "path": "/api/analyze",
          "method": "POST",
          "body": {
            "text": ""
          },
          "json_contains": {
            "success": false
          }
        }
      ]
    },
    {
      "argv": [
        "node",
        "node_modules/json-server/lib/cli/bin.js",
        "--watch",
        "examples/db.json",
        "--host",
        "127.0.0.1",
        "--port",
        "{port}"
      ],
      "ready": "/samples",
      "checks": [
        {
          "path": "/samples/fiction-1",
          "json_contains": {
            "id": "fiction-1"
          }
        },
        {
          "path": "/samples",
          "method": "POST",
          "body": {
            "id": "smoke-created",
            "fullQuestion": "self-authored test"
          },
          "status": 201,
          "json_contains": {
            "id": "smoke-created"
          }
        },
        {
          "path": "/samples/smoke-created",
          "method": "DELETE"
        }
      ]
    },
    {
      "argv": [
        "{python}",
        "-m",
        "http.server",
        "{port}",
        "--bind",
        "127.0.0.1"
      ],
      "checks": [
        {
          "path": "/index.html",
          "text_contains": "<html"
        }
      ]
    }
  ]
}
